# 项目配置：只保留 OTA_URL / BOARD 二选一 choice / 语言 / 唤醒词

menu "Kyle Firmware"

config OTA_URL
    string "Default OTA URL"
    default "http://192.168.0.114:8080/api/iot/ota/"
    help
        首次激活的默认 OTA 基地址（指向自建 admin-backend）；NVS wifi/ota_url 可覆盖。

choice BOARD
    prompt "Board selection"
    default BOARD_SUPERMINI_C3
    help
        构建时二选一，只编译选中的一块板。

config BOARD_SUPERMINI_C3
    bool "supermini-c3 (ESP32-C3, SSD1306 OLED, 4MB)"
    depends on IDF_TARGET_ESP32C3

config BOARD_KYLE_S3_LCD
    bool "kyle-s3-lcd (ESP32-S3, ST7789 + touch, 16MB/PSRAM)"
    depends on IDF_TARGET_ESP32S3

endchoice

config WIFI_SSID
    string "Default WiFi SSID"
    default ""
    help
        配网兜底 SSID（NVS wifi/ssid 为空时使用；menuconfig 填写，不进代码仓库）。

config WIFI_PASSWORD
    string "Default WiFi password"
    default ""
    help
        配网兜底密码（NVS wifi/password 为空时使用；menuconfig 填写，不进代码仓库）。
        生产环境应通过配网流程写入 NVS，此处仅作为开发期兜底。

config LANGUAGE
    string "Language code"
    default "zh-CN"
    help
        用于系统信息上报与显示语言（如 zh-CN / en-US）。

config FIRMWARE_VERSION
    string "Firmware version"
    default "2.2.2"
    help
        固件版本号（OTA check 上报 / 版本比较用，与根 CMakeLists PROJECT_VER 保持一致）。
        发布新版本时在此递增，后端据此判断是否需要升级。

config WAKE_WORD
    string "Wake word text"
    default "铃铛象"
    help
        唤醒词文本；supermini-c3 用 Wakenet、kyle-s3-lcd 用 Multinet。

config AUDIO_SELFTEST
    bool "Run K3 audio self-test on boot"
    default y
    help
        K3 真机验证用：启动后先播 440Hz 正弦（扬声器可闻），再循环打印麦克风电平。
        K6 音频流水线接入后置 n。

endmenu
