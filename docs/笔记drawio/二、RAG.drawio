        </mxCell>
        <mxCell id="9lHHg8SUuANdUzaYMJB6-43" value="将文本切分和映射，先通过切分算法例如BPE等，切分为Token，再为这些Token配置Token ID。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="-623" y="2031" width="397" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9lHHg8SUuANdUzaYMJB6-44" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Comic Sans MS&amp;quot;; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;它是一种文本的预处理，编码和解码是通过Tokenizer来实现Token和Token ID的映射&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;rounded=1;sketch=1;fontFamily=Comic Sans MS;fontSize=16;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="-311" y="1932" width="273" height="90" as="geometry" />
        </mxCell>
        <mxCell id="9lHHg8SUuANdUzaYMJB6-45" value="对文本内容理解，将文本切分为片段后，将这些片段生成向量数据，对于含义相近的片段生成的向量也会相近" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="-623" y="2155" width="397" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9lHHg8SUuANdUzaYMJB6-46" value="Embedding是对文本语义的理解。但它其实并不是实际的理解，而是通过不断训练得到的" style="ellipse;whiteSpace=wrap;html=1;rounded=1;sketch=1;fontFamily=Comic Sans MS;fontSize=16;strokeColor=#666666;" vertex="1" parent="1">
