menu "Pomodoro PC Sync"

    config POMO_SYNC_ENABLE
        bool "Enable pomodoro backend sync (WiFi + HTTP)"
        default y
        help
            Sync pomodoro state with admin-backend via LAN.
            ESP cannot use 127.0.0.1 (that points to ESP itself).

            When PC DHCP IP changes often, prefer one of:
            - SD file /sdcard/config/pomodoro_host.txt (no reflash)
            - Router DHCP reservation for your PC
            - PC hostname with mDNS, e.g. MYPC.local

    config POMO_API_HOST
        string "Backend host (fallback if no SD config)"
        default "192.168.1.100"
        depends on POMO_SYNC_ENABLE
        help
            IP (192.168.x.x) or hostname (MYPC.local).
            Overridden by SD card config/pomodoro_host.txt when present.

    config POMO_API_PORT
        int "Backend HTTP port"
        default 8080
        depends on POMO_SYNC_ENABLE

    config WIFI_SSID
        string "WiFi SSID"
        default "YOUR_SSID"
        depends on POMO_SYNC_ENABLE

    config WIFI_PASSWORD
        string "WiFi password"
        default "YOUR_PASSWORD"
        depends on POMO_SYNC_ENABLE

endmenu

menu "NetEase Media Sync"

    config MEDIA_SYNC_ENABLE
        bool "Enable NetEase lyric/media sync (HTTP to PC daemon)"
        default y
        depends on POMO_SYNC_ENABLE
        help
            Sync lyrics and playback with NetEase Cloud Music on LAN PC.
            PC daemon listens on port 8765 by default.

    config MEDIA_API_HOST
        string "Media bridge host (fallback if no SD config)"
        default "192.168.0.114"
        depends on MEDIA_SYNC_ENABLE
        help
            IP of the PC running pc_daemon (NetEase bridge).
            Overridden by SD card config/media_host.txt when present.

    config MEDIA_API_PORT
        int "Media bridge HTTP port"
        default 8765
        depends on MEDIA_SYNC_ENABLE

endmenu
