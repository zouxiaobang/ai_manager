<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ai.manager</groupId>
        <artifactId>admin-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>admin-system</artifactId>
    <name>admin-system</name>
    <description>系统业务模块（用户等）</description>

    <dependencies>
        <dependency>
            <groupId>com.ai.manager</groupId>
            <artifactId>admin-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ai.manager</groupId>
            <artifactId>admin-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hierynomus</groupId>
            <artifactId>sshj</artifactId>
        </dependency>

        <!-- PostgreSQL + pgvector -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PDF 解析 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- HTML 解析 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- admin-system 覆盖率门禁：只对已测达标的 service.support 纯逻辑类开 CLASS 级 80% 门禁（见 includes），防回归 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- 阶段 7：admin-system 全量 BUNDLE 80% 距离过远（553 类当前仅约 10%），
                                     改为「只开已达标区域」：对阶段 5/6 拆分并已测达标（LINE+BRANCH ≥80%）的
                                     service.support 纯逻辑类开 CLASS 级 80% 门禁防回归；
                                     其余类随补测达标后再逐个纳入 includes。 -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.ai.manager.system.service.support.StorageOrphanReferenceCollector*</include>
                                        <include>com.ai.manager.system.service.support.AiKnowledgeConfigStore*</include>
                                        <include>com.ai.manager.system.service.support.EcSalesOrderImportParser*</include>
                                        <include>com.ai.manager.system.service.support.EcSettlementSummaryAssembler*</include>
                                        <include>com.ai.manager.system.service.support.EcInventoryVoAssembler*</include>
                                        <include>com.ai.manager.system.service.support.EcSettingsBuiltinSupport*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
